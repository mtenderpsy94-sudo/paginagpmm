---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="legal">
    <div class="container narrow">
      <p class="eyebrow">Legal</p>
      <h1>{title}</h1>
      <p class="updated muted">Last updated: {updated}</p>

      <div class="legal-notice" role="note">
        <Icon name="check" size={18} />
        <p><strong>Template notice.</strong> This page is a starting template. Review and complete it with a qualified legal professional before publishing. Placeholders are marked <code>[TODO]</code>.</p>
      </div>

      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3rem, 6vw, 5rem); }
  .updated { font-size: var(--fs-sm); margin-top: -0.3rem; }

  .legal-notice {
    display: flex; gap: 0.7rem; align-items: flex-start;
    background: var(--accent-soft); border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg); padding: 1rem 1.2rem; margin: 1.5rem 0 2.5rem;
  }
  .legal-notice .ic { color: var(--accent-strong); flex: none; margin-top: 0.15rem; }
  .legal-notice p { margin: 0; font-size: var(--fs-sm); color: var(--heading); }
  .legal-notice code { background: var(--surface); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; }

  .prose :global(h2) { font-size: var(--fs-h3); margin: 2.2rem 0 0.8rem; }
  .prose :global(h3) { font-size: var(--fs-lg); margin: 1.6rem 0 0.6rem; }
  .prose :global(p) { max-width: 68ch; margin: 0 0 1rem; }
  .prose :global(ul) { max-width: 68ch; margin: 0 0 1.2rem; padding-left: 1.2rem; list-style: disc; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(strong) { color: var(--heading); }
  .prose :global(code) { background: var(--bg-alt); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }
  .prose :global(a) { color: var(--accent-strong); }
</style>
