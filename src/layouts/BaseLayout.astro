---
import '../styles/global.css';
import { site } from '../data/site';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  lang?: Lang;
}

const { title, description, image, ogType, lang = 'en' } = Astro.props;

const sameAs = [site.socials.instagram, site.socials.linkedin].filter(Boolean);
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Full-Stack Marketeer & Growth Hacker',
  description: 'Full-stack marketeer building landing pages, copy, Meta Ads and funnels that turn budgets into measurable revenue.',
  address: { '@type': 'PostalAddress', addressCountry: 'NL' },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <Seo title={title} description={description} image={image} ogType={ogType} lang={lang} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <CookieBanner lang={lang} />

    <script>
      // Enable JS-only scroll reveals, then observe.
      document.documentElement.classList.add('js');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in-view'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
