---
import { services } from '../data/services';
import { servicesEs, type Lang } from '../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const es = lang === 'es';
// Separate Netlify form for Spanish so its fields (budget) are registered on their own.
const formName = es ? 'contacto-espanol' : 'free-funnel-audit';
const roles = ['Performance Marketeer', 'Growth Hacker', 'Web Designer & CRO Specialist', 'Something else'];
// Spanish form asks for a monthly budget in US dollars instead of the role.
const budgetsUsd = ['< $1,000', '$1,000 – 2,500', '$2,500 – 5,000', '$5,000+', 'Aún no lo sé'];

const t = es
  ? {
      hp: 'No llenes este campo si eres humano:',
      name: 'Nombre', email: 'Email', company: 'Empresa', website: 'Sitio web', phone: 'Teléfono',
      selectLabel: 'Presupuesto mensual de marketing (USD)', selectPlaceholder: 'Elige un rango',
      skills: '¿Qué servicios te interesan?',
      message: 'Mensaje', messagePh: 'Cuéntame un poco sobre tu negocio, tu oferta y dónde estás atascado.',
      consent: 'Acepto que Ender Muñoz me contacte sobre mi solicitud. Ver la', privacy: 'política de privacidad',
      submit: 'Agendar una llamada', sending: 'Enviando…',
      error: 'Algo salió mal. Inténtalo de nuevo o escríbeme por WhatsApp.',
      okTitle: '¡Gracias, ya lo recibí!',
      okBody: 'Te respondo en un máximo de dos días hábiles. ¿Prefieres hablar ya? Escríbeme por WhatsApp.',
    }
  : {
      hp: 'Don’t fill this out if you’re human:',
      name: 'Name', email: 'Email', company: 'Company', website: 'Website', phone: 'Phone',
      selectLabel: 'What role are you looking to fill?', selectPlaceholder: 'Select a role',
      skills: 'Which skills matter most for the role?',
      message: 'Message', messagePh: 'Tell me about the role, your team and the clients you work with.',
      consent: 'I agree that Ender Muñoz may contact me about this role. See the', privacy: 'privacy policy',
      submit: 'Book an interview', sending: 'Sending…',
      error: 'Something went wrong. Please try again, or message me on WhatsApp.',
      okTitle: 'Thanks, I’ve got it.',
      okBody: 'I’ll get back to you within two business days to schedule the interview. Prefer to talk now? Message me on WhatsApp.',
    };
const selectName = es ? 'budget' : 'role';
const options = es ? budgetsUsd : roles;
---
<div class="form-wrap">
  <form
    name={formName}
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="audit-form"
    id="audit-form"
  >
    <input type="hidden" name="form-name" value={formName} />
    <input type="hidden" name="language" value={lang} />
    <p class="hp">
      <label>{t.hp} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="grid-2">
      <div class="field">
        <label for="f-name">{t.name} <span class="req" aria-hidden="true">*</span></label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-email">{t.email} <span class="req" aria-hidden="true">*</span></label>
        <input id="f-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-company">{t.company} <span class="req" aria-hidden="true">*</span></label>
        <input id="f-company" name="company" type="text" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="f-website">{t.website}</label>
        <input id="f-website" name="website" type="url" inputmode="url" placeholder="https://" autocomplete="url" />
      </div>
      <div class="field">
        <label for="f-phone">{t.phone}</label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="f-select">{t.selectLabel} <span class="req" aria-hidden="true">*</span></label>
        <select id="f-select" name={selectName} required>
          <option value="" disabled selected>{t.selectPlaceholder}</option>
          {options.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
    </div>

    <fieldset class="field services">
      <legend>{t.skills}</legend>
      <div class="chips">
        {services.map((s) => (
          <label class="chip">
            <input type="checkbox" name="services" value={s.name} />
            <span>{es ? servicesEs[s.slug]?.name ?? s.name : s.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="field">
      <label for="f-message">{t.message}</label>
      <textarea id="f-message" name="message" rows="4" placeholder={t.messagePh}></textarea>
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" value="yes" required />
      <span>{t.consent} <a href="/legal/privacy-policy">{t.privacy}</a>. <span class="req" aria-hidden="true">*</span></span>
    </label>

    <button type="submit" class="btn btn--primary btn--lg form-submit" data-label={t.submit} data-sending={t.sending}>{t.submit}</button>
    <p class="form-error" id="form-error" role="alert" hidden>{t.error}</p>
  </form>

  <div class="form-success" id="form-success" hidden role="status">
    <h3>{t.okTitle}</h3>
    <p>{t.okBody}</p>
  </div>
</div>

<style>
  .form-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 2.2rem); box-shadow: var(--shadow-md); }
  .hp { position: absolute; left: -9999px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; align-items: end; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.1rem; min-width: 0; }
  .grid-2 .field { margin-bottom: 0; }
  label { font-size: var(--fs-sm); font-weight: 600; color: var(--heading); }
  .req { color: var(--accent-strong); }
  input, select, textarea {
    font: inherit; font-size: var(--fs-sm); color: var(--heading); background: var(--bg);
    border: 1px solid var(--border-strong); border-radius: var(--radius); padding: 0.7rem 0.85rem; width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  textarea { resize: vertical; }

  .services { border: 0; padding: 0; margin: 0 0 1.1rem; }
  .services legend { font-size: var(--fs-sm); font-weight: 600; color: var(--heading); padding: 0; margin-bottom: 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; border: 1px solid var(--border-strong); border-radius: var(--radius-pill); padding: 0.45rem 0.9rem; cursor: pointer; font-weight: 500; }
  .chip input { width: auto; accent-color: var(--accent-strong); }
  .chip:has(input:checked) { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); }

  .consent { display: flex; gap: 0.6rem; align-items: flex-start; font-weight: 400; font-size: var(--fs-sm); color: var(--body); margin-bottom: 1.3rem; }
  .consent input { width: auto; margin-top: 0.2rem; accent-color: var(--accent-strong); }
  .form-submit { width: 100%; justify-content: center; }
  .form-error { color: #B00020; font-size: var(--fs-sm); margin: 0.9rem 0 0; }

  .form-success { text-align: center; padding: 1rem 0; }
  .form-success h3 { color: var(--accent-strong); }

  @media (max-width: 560px) { .grid-2 { grid-template-columns: 1fr; gap: 1.1rem; } }
</style>

<script>
  const form = document.getElementById('audit-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');

  const encode = (data: FormData) => {
    const params = new URLSearchParams();
    data.forEach((value, key) => params.append(key, value.toString()));
    return params.toString();
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (error) error.hidden = true;
    if (!form.reportValidity()) return;
    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit');
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = submitBtn.dataset.sending ?? ''; }
    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: encode(new FormData(form)),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      if (success) success.hidden = false;
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      if (error) error.hidden = false;
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = submitBtn.dataset.label ?? ''; }
    }
  });
</script>
