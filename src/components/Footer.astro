---
import { site } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
import { ui, servicesEs, homePath, type Lang } from '../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = ui[lang];
const es = lang === 'es';

const year = new Date().getFullYear();
const wa = `https://wa.me/${site.whatsapp.intl}?text=${encodeURIComponent(t.whatsappMessage)}`;
const hasSocials = site.socials.instagram || site.socials.linkedin;
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div class="foot-brand">
      <a href={homePath[lang]} class="logo" aria-label={t.homeAria}>Ender Muñoz<span class="dot">.</span></a>
      <p class="foot-title">{t.title}</p>
      <p class="muted">{t.footerBlurb}</p>
      {hasSocials && (
        <div class="socials">
          {site.socials.instagram && (
            <a href={site.socials.instagram} aria-label="Ender Muñoz on Instagram" rel="me noopener" target="_blank"><Icon name="instagram" size={20} /></a>
          )}
          {site.socials.linkedin && (
            <a href={site.socials.linkedin} aria-label="Ender Muñoz on LinkedIn" rel="me noopener" target="_blank"><Icon name="linkedin" size={20} /></a>
          )}
        </div>
      )}
    </div>

    <nav class="foot-col" aria-label={t.footerServices}>
      <h4>{t.footerServices}</h4>
      <ul>
        {services.map((s) => (
          <li><a href={es ? '/espanol#servicios' : `/services/${s.slug}`}>{es ? servicesEs[s.slug]?.name ?? s.name : s.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="foot-col" aria-label={t.footerExplore}>
      <h4>{t.footerExplore}</h4>
      <ul>
        {es ? (
          <>
            <li><a href="/espanol#enfoque">{t.myApproach}</a></li>
            <li><a href="/espanol#audit">{t.cta}</a></li>
            <li><a href="/" hreflang="en">English version</a></li>
          </>
        ) : (
          <>
            <li><a href="/our-approach">{t.myApproach}</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/#audit">{t.cta}</a></li>
            <li><a href="/espanol" hreflang="es">Versión en español</a></li>
          </>
        )}
        <li><a href="/legal/privacy-policy">{t.privacy}</a></li>
        <li><a href="/legal/terms">{t.terms}</a></li>
        <li><a href="/legal/cookie-policy">{t.cookies}</a></li>
      </ul>
    </nav>

    <div class="foot-col">
      <h4>{t.footerContact}</h4>
      <ul class="contact">
        <li><a href={wa}><Icon name="whatsapp" size={18} /> WhatsApp</a></li>
        {site.email && (
          <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a></li>
        )}
        <li><span><Icon name="map-pin" size={18} /> {es ? 'Países Bajos' : site.location}</span></li>
      </ul>
    </div>
  </div>

  <div class="container foot-bottom">
    <p>© {year} {site.name}. {t.rights}</p>
    <p class="legal-ids">KvK {site.legal.kvk} · BTW {site.legal.btw}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--bg-alt); border-top: 1px solid var(--border); padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem; }
  .logo { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: var(--heading); letter-spacing: -0.03em; }
  .logo .dot { color: var(--accent); }
  .foot-title { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin: 0.35rem 0 0; }
  .logo:hover { text-decoration: none; }

  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2rem 1.5rem; }
  .foot-brand p { max-width: 34ch; margin: 1rem 0 1.2rem; font-size: var(--fs-sm); }
  .socials { display: flex; gap: 0.6rem; }
  .socials a {
    width: 40px; height: 40px; border-radius: var(--radius); display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--border); color: var(--heading);
  }
  .socials a:hover { color: var(--accent-strong); border-color: var(--border-strong); }

  .foot-col h4 { font-family: var(--font-body); font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0 0 1rem; }
  .foot-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .foot-col a { color: var(--body); font-size: var(--fs-sm); text-decoration: none; }
  .foot-col a:hover { color: var(--accent-strong); }
  .contact a, .contact span { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--body); font-size: var(--fs-sm); }
  .contact a:hover { color: var(--accent-strong); }
  .contact .ic { color: var(--accent-strong); flex: none; }

  .foot-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    font-size: 0.85rem; color: var(--muted);
  }
  .foot-bottom p { margin: 0; }
  .legal-ids { font-variant-numeric: tabular-nums; }

  @media (max-width: 860px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
