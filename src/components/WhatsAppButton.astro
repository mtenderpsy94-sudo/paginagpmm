---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = ui[lang];
const href = `https://wa.me/${site.whatsapp.intl}?text=${encodeURIComponent(t.whatsappMessage)}`;
---
<a class="wa-float" href={href} target="_blank" rel="noopener" aria-label={t.whatsappAria}>
  <Icon name="whatsapp" size={30} />
</a>

<style>
  .wa-float {
    position: fixed; z-index: 90;
    right: max(1.1rem, env(safe-area-inset-right, 0px));
    bottom: max(1.1rem, env(safe-area-inset-bottom, 0px));
    width: 56px; height: 56px; border-radius: 50%;
    background: #25D366; color: #fff;
    display: grid; place-items: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .wa-float:hover { transform: translateY(-2px) scale(1.04); box-shadow: 0 12px 30px rgba(37, 211, 102, 0.5); text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } .wa-float:hover { transform: none; } }
</style>
