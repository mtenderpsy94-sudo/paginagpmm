---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FunnelDiagram from '../components/FunnelDiagram.astro';
import AuditForm from '../components/AuditForm.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import '../styles/home.css';

const disciplines = [
  { icon: 'filter', label: 'Funnel' },
  { icon: 'pen', label: 'Copy' },
  { icon: 'cart', label: 'Checkout' },
  { icon: 'layout', label: 'Web' },
  { icon: 'target', label: 'Ads' },
  { icon: 'trending-up', label: 'Content' },
] as const;

const steps = [
  { n: '01', title: 'Audit', when: 'Week 1', body: 'I map the funnel, traffic and numbers to find exactly where money is leaking.' },
  { n: '02', title: 'Strategy', when: 'Week 1–2', body: 'A clear plan: offer, funnel structure, copy angles and the channels that fit the client.' },
  { n: '03', title: 'Build', when: 'Weeks 2–5', body: 'I design, write and ship the full system: pages, checkout, emails and tracking.' },
  { n: '04', title: 'Scale', when: 'Ongoing', body: 'I test, optimize and scale what works, month over month.' },
];

const dayOne = [
  'Funnel architecture & conversion optimization',
  'Psychological, conversion-focused copywriting',
  'Meta Ads strategy, creatives and tracking',
  'A 360° view of every client’s business',
];

const interviewIncludes = [
  'A reply within two business days',
  'A walkthrough of my funnels, copy and campaigns',
  'Open to joining a growth team in Enschede',
];

const clients = [
  { name: 'Omnia Healing Grounds', logo: '/images/omnia-logo.jpg' },
  { name: 'RitmoFlow', logo: '/images/ritmoflow-logo.jpg' },
];
---
<BaseLayout
  title="Ender Muñoz | Full-Stack Marketeer & Growth Hacker"
  description="Ender Muñoz, Full-Stack Marketeer & Growth Hacker. Landing pages, psychological copywriting, Meta Ads and funnel architecture that turn budgets into measurable revenue. Looking to join a growth team in Enschede."
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Full-Stack Marketeer &amp; Growth Hacker</p>
        <h1>Everything your marketing team needs to build, scale, and <span class="hl">convert traffic</span>.</h1>
        <p class="lead">From high-converting landing pages to psychological copywriting, Meta Ads, and funnel architecture. I design systems that turn budgets into measurable revenue. Looking to join a forward-thinking growth team in Enschede.</p>
        <p class="hero-note muted">Based in the Netherlands · Open to roles in Enschede</p>
      </div>

      <div class="hero-right">
        <img src="/images/ender.jpg" alt="Ender Muñoz, Full-Stack Marketeer & Growth Hacker" class="hero-photo reveal" width="1000" height="563" fetchpriority="high" decoding="async" />
        <aside class="hero-card reveal" aria-label="What I bring from day one">
        <p class="hc-title">What I bring from day one</p>
        <ul class="hc-list">
          {dayOne.map((item) => (
            <li><Icon name="check" size={18} /> {item}</li>
          ))}
        </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- OFFER / PAIN-POINT HOOK -->
  <section class="section offer">
    <div class="container offer-grid">
      <div class="offer-copy reveal">
        <h2>How much of your clients' budget actually <span class="hl">turned into results</span> this year?</h2>
        <p class="lead">Most business owners can't answer. They've only had scattered tactics, reports that don't match the bank account, and campaigns that vanish without results. <strong>That's the gap I close. Within 5 weeks, every client account I touch gets:</strong></p>
        <a href="#audit" class="btn btn--primary btn--lg">Book an interview</a>
      </div>
      <ul class="offer-list reveal">
        <li><span class="ol-ic"><Icon name="check" size={18} /></span> <span>A clear diagnosis of where your money is being wasted</span></li>
        <li><span class="ol-ic"><Icon name="check" size={18} /></span> <span>Real market research and honest competitive positioning</span></li>
        <li><span class="ol-ic"><Icon name="check" size={18} /></span> <span>A 12-month plan, month by month, with creatives, channels and targets</span></li>
      </ul>
    </div>
  </section>

  <!-- CLIENTS / SOCIAL PROOF -->
  <section class="clients">
    <div class="container">
      <p class="clients-label">Businesses I've helped grow</p>
      <div class="clients-logos">
        {clients.map((c) => (
          <img src={c.logo} alt={c.name} class="client-logo" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
  </section>

  <!-- 2. MANIFESTO -->
  <section class="section section--alt">
    <div class="container narrow manifesto reveal">
      <p class="eyebrow">What I believe</p>
      <p class="manifesto-text">Likes don't pay the bills. I build <span class="hl">measurable sales systems</span>, with every euro of traffic tracked from the first click to the repeat purchase. If it can't be measured, it can't be scaled.</p>
      <p class="slogan">“I build sales systems, not vanity metrics.”</p>
    </div>
  </section>

  <!-- Bridge image: half on cream, half on white -->
  <div class="bridge">
    <div class="container">
      <img src="/images/growth-team.jpg" alt="Two colleagues working together on a laptop" class="bridge-img" width="1000" height="1339" loading="lazy" decoding="async" />
    </div>
  </div>

  <!-- 3. YOUR OWN GROWTH TEAM -->
  <section class="section gt-team" id="approach">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">My approach</p>
        <h2>One marketeer. One system. <span class="hl">Every part pulling together.</span></h2>
        <p class="lead muted">Most businesses buy funnel, copy, checkout, web, ads and content from different people who never talk to each other. I run them as a single system, so every piece reinforces the next.</p>
      </div>

      <ul class="disciplines reveal">
        {disciplines.map((d) => (
          <li>
            <span class="d-ic"><Icon name={d.icon} size={22} /></span>
            {d.label}
          </li>
        ))}
      </ul>

      <FunnelDiagram />
      <FunnelDiagram steps={['Cold traffic', 'Quiz', 'Mini VSL', 'Checkout + Order bump', 'Upsell', 'Downsell', 'Recovery emails']} />
      <p class="funnel-caption muted reveal">From the first ad click to a customer who buys again, designed, built and tracked end to end.</p>
    </div>
  </section>

  <!-- 4. SERVICES -->
  <section class="section section--alt">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">My growth stack</p>
        <h2>Everything a client needs to <span class="hl">sell online</span></h2>
        <p class="lead muted">These are the capabilities I bring to your agency's client portfolio from day one:</p>
      </div>
      <div class="services-grid">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- 5. PROCESS -->
  <section class="section">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">How I work</p>
        <h2>A clear path from <span class="hl">leak to scale</span></h2>
      </div>
      <ol class="process">
        {steps.map((s) => (
          <li class="step reveal">
            <span class="step-n">{s.n}</span>
            <div class="step-body">
              <div class="step-head">
                <h3>{s.title}</h3>
                <span class="step-when">{s.when}</span>
              </div>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="process-link reveal"><a href="/our-approach">See my full approach <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <!-- 6. FINAL CTA + FORM -->
  <section class="section section--alt" id="audit">
    <div class="container audit-grid">
      <div class="audit-copy reveal">
        <p class="eyebrow">Hiring for your growth team?</p>
        <h2>Let's grow your <span class="hl">clients</span> together</h2>
        <p class="lead muted">Tell me about the role, your team and the clients you work with. I'll come prepared with ideas for your portfolio, not just a CV.</p>
        <ul class="audit-list">
          {interviewIncludes.map((item) => (<li><Icon name="check" size={18} /> {item}</li>))}
        </ul>
      </div>
      <div class="audit-form-col reveal">
        <AuditForm />
      </div>
    </div>
  </section>
</BaseLayout>
