---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist. Head back to the GPMM home page or explore our services."
>
  <section class="notfound">
    <div class="container narrow">
      <p class="code">404</p>
      <h1>This page took a <span class="hl">wrong turn</span></h1>
      <p class="lead muted">The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
      <div class="nf-cta">
        <a href="/" class="btn btn--primary btn--lg">Back to home</a>
        <a href="/services" class="btn btn--ghost btn--lg">Browse services</a>
      </div>
      <p class="nf-links">
        Or go straight to a <a href="/free-funnel-audit">free funnel audit <Icon name="arrow-right" size={14} /></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { padding-block: clamp(3.5rem, 10vw, 7rem); text-align: center; }
  .code { font-family: var(--font-display); font-weight: 700; font-size: clamp(3.5rem, 12vw, 6rem); color: var(--accent); line-height: 1; margin: 0 0 0.5rem; letter-spacing: -0.04em; }
  .notfound .lead { max-width: 46ch; margin-inline: auto; margin-bottom: 2rem; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-bottom: 1.5rem; }
  .nf-links { font-size: var(--fs-sm); color: var(--muted); }
  .nf-links a { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 600; }
</style>
