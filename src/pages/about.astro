---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const values = [
  { icon: 'target', title: 'Results over noise', body: 'We care about revenue and tracked outcomes, not follower counts or busywork.' },
  { icon: 'check', title: 'Straight talk', body: "We tell you what we'd do with our own money, including when the answer is 'not yet'." },
  { icon: 'filter', title: 'Built to last', body: 'We build systems you own and understand, not black boxes you depend on us for.' },
];
---
<BaseLayout
  title="About"
  description="GPMM is a founder-led funnel and growth agency based in the Netherlands, serving clients across Europe."
>
  <section class="about-hero">
    <div class="container narrow reveal">
      <p class="eyebrow">About</p>
      <h1>A founder-led growth agency in the <span class="hl">Netherlands</span></h1>
      <p class="lead muted">GPMM helps info-products, creators, coaches and e-commerce brands turn traffic into customers with measurable systems instead of guesswork.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container story reveal">
      <div class="story-text">
        <p class="eyebrow">Why GPMM exists</p>
        <h2>Most marketing is disconnected. We fix that.</h2>
        <p>Too many businesses buy funnels, copy, ads and websites from different people who never talk to each other. The result is wasted budget and traffic that never becomes revenue.</p>
        <p>GPMM was built to run those pieces as one system (designed, measured and scaled together) so your marketing finally works like a machine instead of a pile of parts.</p>
        <p class="muted"><em>[TODO: Ender, add your personal story here: your background, how you started, and why you care about this. 2–3 short paragraphs.]</em></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container founder reveal">
      <div class="founder-photo" role="img" aria-label="Photo of Ender Muñoz, coming soon">
        <Icon name="user" size={40} />
        <span>[TODO: founder photo]</span>
      </div>
      <div class="founder-body">
        <p class="eyebrow">Founder</p>
        <h2>{site.founder}</h2>
        <p class="founder-role">Founder, GPMM</p>
        <p>Ender leads strategy and builds the systems behind GPMM's work: funnels, copy, checkout, web and ads. <em class="muted">[TODO: add a short bio: experience, focus, a line of personality.]</em></p>
        <a href="/free-funnel-audit" class="btn btn--primary">Work with Ender</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">What we value</p>
        <h2>How we work with clients</h2>
      </div>
      <div class="values-grid">
        {values.map((v) => (
          <div class="value-card reveal">
            <span class="value-ic"><Icon name={v.icon} size={22} /></span>
            <h3>{v.title}</h3>
            <p class="muted">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Let's build your growth system"
    text="Start with a free funnel audit and see where your biggest opportunities are, no obligation."
  />
</BaseLayout>

<style>
  .about-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .about-hero .lead { max-width: 56ch; }

  .story { max-width: 760px; }
  .story-text h2 { margin-bottom: 1rem; }
  .story-text p { max-width: 62ch; }

  .founder { display: grid; grid-template-columns: 300px 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .founder-photo {
    aspect-ratio: 4 / 5; border-radius: var(--radius-lg); background: var(--accent-soft);
    border: 1px dashed var(--border-strong); color: var(--accent-strong);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem;
    font-size: var(--fs-sm); font-weight: 600; text-align: center; padding: 1rem;
  }
  .founder-body h2 { margin-bottom: 0.2rem; }
  .founder-role { color: var(--accent-strong); font-weight: 600; margin-bottom: 1rem; }
  .founder-body p { max-width: 54ch; margin-bottom: 1.3rem; }

  .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.1rem; }
  .value-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-sm); }
  .value-ic { width: 52px; height: 52px; border-radius: var(--radius); background: var(--accent-soft); color: var(--accent-strong); display: grid; place-items: center; margin-bottom: 1.1rem; }
  .value-card h3 { font-size: var(--fs-lg); margin: 0 0 0.5rem; }
  .value-card p { margin: 0; font-size: var(--fs-sm); }

  @media (max-width: 680px) {
    .founder { grid-template-columns: 1fr; }
    .founder-photo { max-width: 260px; }
  }
</style>
