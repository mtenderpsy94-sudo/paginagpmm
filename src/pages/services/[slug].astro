---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { site, SHOW_PRICES } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props { service: Service; }
const { service } = Astro.props;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: service.hero.subtitle,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['Netherlands', 'Belgium', 'Luxembourg'],
  url: new URL(`/services/${service.slug}`, site.url).href,
};
---
<BaseLayout title={service.name} description={service.hero.subtitle}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} slot="head" />

  <!-- HERO -->
  <section class="svc-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/services">Services</a> <span aria-hidden="true">/</span>
        <span>{service.name}</span>
      </nav>
      <span class="svc-ic"><Icon name={service.icon} size={28} /></span>
      <h1>{service.hero.title}</h1>
      <p class="lead">{service.hero.subtitle}</p>
      {SHOW_PRICES && <p class="price">Starting from <strong>{service.startingFrom}</strong></p>}
      <div class="hero-cta">
        <a href="/free-funnel-audit" class="btn btn--primary btn--lg">Get your free funnel audit</a>
        <a href="/services" class="btn btn--ghost btn--lg">All services</a>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section section--alt">
    <div class="container narrow reveal">
      <p class="eyebrow">The problem</p>
      <p class="problem-text">{service.problem}</p>
    </div>
  </section>

  <!-- INCLUDES + DELIVERABLES -->
  <section class="section">
    <div class="container two-col">
      <div class="reveal">
        <p class="eyebrow">What's included</p>
        <h2>What you can get</h2>
        <ul class="check-list">
          {service.includes.map((i) => (
            <li><Icon name="check" size={18} /> <span>{i}</span></li>
          ))}
        </ul>
      </div>
      <div class="deliverables-card reveal">
        <h3>What you walk away with</h3>
        <ul class="check-list">
          {service.deliverables.map((d) => (
            <li><Icon name="check" size={18} /> <span>{d}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section--alt">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">How it works</p>
        <h2>The process</h2>
      </div>
      <ol class="process">
        {service.process.map((s, i) => (
          <li class="step reveal">
            <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FOR WHO -->
  <section class="section">
    <div class="container narrow reveal">
      <p class="eyebrow">Who it's for</p>
      <h2>This is a fit if you're…</h2>
      <ul class="check-list two">
        {service.forWho.map((w) => (
          <li><Icon name="check" size={18} /> <span>{w}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <div class="sec-head reveal">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered</h2>
      </div>
      <FAQ items={service.faq} />
    </div>
  </section>

  <CtaBand text={`Interested in ${service.name.toLowerCase()}? Start with a free funnel audit — a clear picture of your biggest opportunities, with no obligation.`} />
</BaseLayout>

<style>
  .svc-hero { padding-block: clamp(2.2rem, 5vw, 4rem) clamp(2.5rem, 5vw, 3.5rem); }
  .crumbs { font-size: var(--fs-sm); color: var(--muted); margin-bottom: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--accent-strong); }
  .crumbs span:last-child { color: var(--heading); font-weight: 500; }
  .svc-ic { width: 60px; height: 60px; border-radius: var(--radius-lg); background: var(--accent-soft); color: var(--accent-strong); display: grid; place-items: center; margin-bottom: 1.3rem; }
  .svc-hero h1 { max-width: 16ch; }
  .svc-hero .lead { max-width: 54ch; margin-bottom: 1.5rem; }
  .price { font-family: var(--font-display); font-size: var(--fs-lg); color: var(--heading); margin-bottom: 1.3rem; }
  .price strong { color: var(--accent-strong); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .problem-text { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 1rem + 1.6vw, 1.9rem); line-height: 1.35; color: var(--heading); letter-spacing: -0.01em; text-wrap: balance; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }
  .check-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.2rem; }
  .check-list li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--body); font-size: var(--fs-sm); }
  .check-list .ic { color: var(--accent-strong); flex: none; margin-top: 0.15rem; }
  .check-list.two { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1.5rem; }
  .deliverables-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-sm); }
  .deliverables-card h3 { font-size: var(--fs-lg); }

  .sec-head { max-width: 640px; margin-bottom: 2.2rem; }
  .process { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.6rem 2.5rem; }
  .step { display: flex; gap: 1.1rem; align-items: flex-start; }
  .step-n { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--accent-strong); background: var(--accent-soft); width: 46px; height: 46px; border-radius: var(--radius); display: grid; place-items: center; flex: none; font-variant-numeric: tabular-nums; }
  .step-body h3 { margin: 0 0 0.3rem; font-size: var(--fs-lg); }
  .step-body p { margin: 0; font-size: var(--fs-sm); }

  @media (max-width: 820px) {
    .two-col { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .process { grid-template-columns: 1fr; }
    .check-list.two { grid-template-columns: 1fr; }
  }
</style>
